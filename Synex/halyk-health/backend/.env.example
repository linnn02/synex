# Local Docker PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/halyk_health?schema=public

# Supabase PostgreSQL for shared team DB:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?schema=public&sslmode=require
# Keep this secret on the backend only. Flutter and React must never use it directly.

JWT_SECRET=change-me

# Local AI through Ollama. The backend uses mock AI if QWEN_PROVIDER is not ollama and QWEN_API_KEY is empty.
QWEN_PROVIDER=ollama
QWEN_API_KEY=
QWEN_API_URL=http://127.0.0.1:11434/api/chat
QWEN_MODEL=qwen3:latest
QWEN_TIMEOUT_MS=180000
PORT=4000
