generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  PHARMACY_ADMIN
  PHARMACY_STAFF
}

enum RelationType {
  SELF
  CHILD
  MOTHER
  FATHER
  GRANDMOTHER
  GRANDFATHER
  OTHER
}

enum InsuranceStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  DRAFT
  SENT
  ACTIVE
  COMPLETED
}

enum ScheduleStatus {
  PLANNED
  TAKEN
  MISSED
}

enum MatchType {
  EXACT
  ACTIVE_SUBSTANCE
  ALTERNATIVE
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  iin          String?
  phone        String    @unique
  email        String    @unique
  passwordHash String
  role         UserRole
  birthDate    DateTime?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctorProfile       DoctorProfile?
  patientProfiles     PatientProfile[]
  doctorAppointments  Appointment[]    @relation("DoctorAppointments")
  doctorPrescriptions Prescription[]   @relation("DoctorPrescriptions")
  pharmacyStaff       PharmacyStaff[]
}

model PatientProfile {
  id              String          @id @default(uuid())
  userId          String
  fullName        String
  iin             String?
  relationType    RelationType
  insuranceStatus InsuranceStatus @default(ACTIVE)
  clinicId        String?
  primaryDoctorId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic        Clinic?        @relation(fields: [clinicId], references: [id])
  primaryDoctor DoctorProfile? @relation(fields: [primaryDoctorId], references: [id])

  appointments        Appointment[]
  prescriptions       Prescription[]
  medicationSchedules MedicationSchedule[]
  cartItems           CartItem[]
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String
  bin       String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors         DoctorProfile[]
  appointments    Appointment[]
  patientProfiles PatientProfile[]
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  clinicId       String
  specialization String
  roomNumber     String?
  scheduleText   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientProfiles PatientProfile[]
}

model Appointment {
  id               String            @id @default(uuid())
  patientProfileId String
  doctorId         String
  clinicId         String
  appointmentDate  DateTime
  complaint        String
  status           AppointmentStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  doctor         User           @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescription   Prescription?
}

model Prescription {
  id               String             @id @default(uuid())
  appointmentId    String             @unique
  patientProfileId String
  doctorId         String
  diagnosis        String
  rawText          String
  doctorComment    String?
  aiSummary        String?
  aiDisclaimer     String?
  status           PrescriptionStatus @default(SENT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  appointment    Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile         @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  doctor         User                   @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  medicines      PrescriptionMedicine[]
}

model PrescriptionMedicine {
  id              String   @id @default(uuid())
  prescriptionId  String
  medicineName    String
  dosage          String
  frequency       String
  duration        String
  instruction     String
  quantityNeeded  Int
  activeSubstance String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prescription Prescription          @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  matches      MedicineMatch[]
  schedules    MedicationSchedule[]
}

model MarketProduct {
  id              String   @id @default(uuid())
  title           String
  activeSubstance String
  dosage          String
  form            String
  manufacturer    String
  price           Float
  stock           Int
  pharmacyName    String
  productUrl      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches   MedicineMatch[]
  cartItems CartItem[]
}

model MedicineMatch {
  id                     String    @id @default(uuid())
  prescriptionMedicineId String
  productId              String
  matchType              MatchType
  confidenceScore        Float
  isAlternative          Boolean   @default(false)
  createdAt              DateTime  @default(now())

  prescriptionMedicine PrescriptionMedicine @relation(fields: [prescriptionMedicineId], references: [id], onDelete: Cascade)
  product              MarketProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MedicationSchedule {
  id                     String         @id @default(uuid())
  patientProfileId       String
  prescriptionMedicineId String
  takeTime               DateTime
  status                 ScheduleStatus @default(PLANNED)
  takenAt                DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  patientProfile       PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  prescriptionMedicine PrescriptionMedicine @relation(fields: [prescriptionMedicineId], references: [id], onDelete: Cascade)
}

model CartItem {
  id               String   @id @default(uuid())
  patientProfileId String
  productId        String
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  product        MarketProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([patientProfileId, productId])
}

// ─── B2B Pharmacy ─────────────────────────────────────────────────────────────

enum PharmacyOrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  DELIVERING
  COMPLETED
  CANCELLED
  OUT_OF_STOCK
}

enum PharmacyStockMovementReason {
  SUPPLY
  SALE
  WRITE_OFF
  CORRECTION
  RETURN
}

enum PharmacyProductForm {
  TABLET
  SYRUP
  SPRAY
  CAPSULE
  DROPS
  OINTMENT
  INJECTION
  OTHER
}

model Pharmacy {
  id               String   @id @default(uuid())
  name             String
  bin              String?  @unique
  address          String
  city             String   @default("Алматы")
  phone            String?
  email            String?
  workingHours     String?
  deliveryEnabled  Boolean  @default(true)
  pickupEnabled    Boolean  @default(true)
  isActive         Boolean  @default(true)
  connectedToHalyk Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  staff    PharmacyStaff[]
  products PharmacyProduct[]
  orders   PharmacyOrder[]
}

model PharmacyStaff {
  id         String   @id @default(uuid())
  userId     String
  pharmacyId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
}

model PharmacyProduct {
  id                  String              @id @default(uuid())
  pharmacyId          String
  name                String
  activeSubstance     String
  dosage              String
  form                PharmacyProductForm @default(OTHER)
  category            String?
  manufacturer        String?
  price               Float
  stock               Int                 @default(0)
  minStock            Int                 @default(5)
  imageUrl            String?
  isAvailable         Boolean             @default(true)
  requiresPrescription Boolean            @default(false)
  description         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  pharmacy       Pharmacy                @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  stockMovements PharmacyStockMovement[]
  orderItems     PharmacyOrderItem[]
}

model PharmacyStockMovement {
  id         String                      @id @default(uuid())
  productId  String
  quantity   Int
  reason     PharmacyStockMovementReason
  comment    String?
  createdAt  DateTime                    @default(now())
  createdBy  String?

  product PharmacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PharmacyOrder {
  id               String              @id @default(uuid())
  pharmacyId       String
  patientProfileId String?
  patientName      String?
  patientPhone     String?
  totalPrice       Float               @default(0)
  deliveryType     String              @default("pickup")
  deliveryAddress  String?
  status           PharmacyOrderStatus @default(NEW)
  comment          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  pharmacy Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  items    PharmacyOrderItem[]
}

model PharmacyOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  order   PharmacyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product PharmacyProduct @relation(fields: [productId], references: [id])
}
